SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=healthra
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to True to run locally with SQLite instead of Postgres (no setup needed)
USE_SQLITE=True

# The one hardcoded login the frontend checks against (no real accounts)
STATIC_LOGIN_EMAIL=human@booking.com
STATIC_LOGIN_PASSWORD=123456
STATIC_LOGIN_NAME=Human
